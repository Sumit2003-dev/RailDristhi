# -------------------------------------------------------------
# RailDristhi — Environment Variables
# -------------------------------------------------------------

# Port for SSR server (defaults to 3000)
PORT=3000

# Node Environment (production / development)
NODE_ENV=production

# (Optional) Google Maps Platform API Key for satellite & terrain maps
# If not provided, RailDristhi automatically uses built-in schematic track projection.
VITE_GOOGLE_MAPS_API_KEY=
